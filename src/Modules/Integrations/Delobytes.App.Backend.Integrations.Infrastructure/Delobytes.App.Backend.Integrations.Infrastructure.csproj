<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Имена классов сгенерированных миграций в нижнем регистре: CS8981 не подавить иначе. -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Delobytes.App.Backend.Persistence\Delobytes.App.Backend.Persistence.csproj" />
    <ProjectReference Include="..\Delobytes.App.Backend.Integrations.Domain\Delobytes.App.Backend.Integrations.Domain.csproj" />
    <ProjectReference Include="..\Delobytes.App.Backend.Integrations.Application\Delobytes.App.Backend.Integrations.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Delobytes.AspNetCore.Logging" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <!-- dotnet ef runs against this project (its design-time factory), not the web host. -->
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Polly" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Delobytes.App.Backend.Integrations.Tests" />
  </ItemGroup>

</Project>
